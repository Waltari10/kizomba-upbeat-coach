{
  "name": "kizomba-upbeat-coach",
  "version": "1.0.0",
  "description": "Browser app that watches you dance Kizomba through the webcam and tells you whether you're dancing on the upbeat or the downbeat.",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/setup.mjs",
    "setup": "node scripts/setup.mjs",
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "e2e": "node test/e2e/run-e2e.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35"
  },
  "devDependencies": {
    "playwright": "^1.55.0"
  }
}
